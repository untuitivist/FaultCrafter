# Only the reviewed public code surface may be added by default.
*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/pyproject.toml
!/faultcrafter/
!/faultcrafter/**/
!/faultcrafter/**/*.py
!/faultcrafter/gui/assets/*.html
!/faultcrafter/gui/assets/*.js
!/faultcrafter/resources/*.json
!/tests/
!/tests/*.py
!/tests/*.cjs
!/examples/
!/examples/*.json
!/docs/
!/docs/architecture.md
!/docs/usage.md
!/docs/development.md
!/desktop/
!/desktop/*.py
!/desktop/*.cmd
!/desktop/*.spec
!/desktop/requirements-build.txt
!/desktop/requirements-build-cpu.txt
!/desktop/README_zh.md
!/tools/
!/tools/export_source.py

# Never publish generated or private artifacts, even inside allowed folders.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.env*
**/.venv*/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/AGENTS.md
**/SKILL.md
**/.NOTE.md
**/task_plan.md
**/findings.md
**/progress.md
**/.agents/
**/.codex/
**/*.tex
**/*.bib
**/*.pdf
**/*.pt
**/*.pth
**/*.ckpt
**/*.safetensors
**/*.npz
**/*.npy
**/*.mat
**/*.csv
**/*.zip
**/*.log
/research/
/deliverables/
/references/
/third_party/
/archives/
/outputs/
/results/
/user_data/
/logs/
/tmp/
/build/
/dist/
/.source-manifest.json
